# FIXTURE TEMPLATE: rendered into the sandbox by scripts/verify.sh.
#
# The credential values are generated at run time and never committed. A repo that
# teaches secret scanning must not ship strings that trip secret scanners: a literal
# token here trips GitHub push protection, every downstream fork's scanners, and the
# bundle's own gitleaks hook.
#
# scripts/verify.sh substitutes each %%PLACEHOLDER%% with random characters matching
# the shape gitleaks looks for, so the hook is exercised against a genuine match.
GITHUB_TOKEN=ghp_%%GITHUB_PAT%%
AWS_ACCESS_KEY_ID=AKIA%%AWS_KEY_ID%%
AWS_SECRET_ACCESS_KEY=%%AWS_SECRET%%
SLACK_BOT_TOKEN=xoxb-%%SLACK_A%%-%%SLACK_B%%-%%SLACK_C%%
